{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iD Interface",
  "version": "0.2.0",
  "identifier": "com.local.idinterface",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "iD Interface",
        "width": 1330,
        "height": 790,
        "minWidth": 1330,
        "minHeight": 790,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
